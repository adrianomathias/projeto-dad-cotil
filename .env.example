# Copie este arquivo para .env e ajuste apenas no seu computador.
# Nunca commite .env nem valores reais de credenciais, CPF ou tokens.

# Ambiente
NODE_ENV=development

# Servidor Express
PORT=3000
# Origem exata permitida pelo CORS. Use http://localhost:5173 no desenvolvimento do Electron.
# Para o aplicativo empacotado com file://, use literalmente: CORS_ORIGIN=null
CORS_ORIGIN=http://localhost:5173

# Banco local e chaves locais (geradas automaticamente se não existirem)
DATABASE_PATH=./data/biblioteca.sqlite
CHAVES_PATH=./data/chaves-locais.json

# Conta inicial criada somente quando o banco está vazio.
# Em produção, ADMIN_SENHA é obrigatória e precisa ter ao menos 12 caracteres.
ADMIN_EMAIL=admin@biblioteca.local
ADMIN_SENHA=Admin@123
# Senha usada ao criar automaticamente contas dos leitores de exemplo.
# Em produção, se definida, deve ter ao menos 12 caracteres.
LEITOR_SENHA_INICIAL=Leitor@123

# Electron: base da API própria. Nunca embutir segredos nesta variável.
VITE_API_URL=http://localhost:3000/api

# Tarefas periódicas de lembretes, atrasos e expiração.
EXECUTAR_AGENDADOR=1

# Integrações externas (opcionais)
GOOGLE_BOOKS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 força o modo simulado; sem SMTP_HOST o modo simulado já é usado.
EMAIL_API_KEY=
EMAIL_REMETENTE=onboarding@resend.dev
MODO_SIMULADO_EMAIL=1

# Somente em desenvolvimento: 0 desativa a consulta externa de CPF no cadastro público.
# Em produção a validação externa é sempre executada.
VALIDAR_CPF_EXTERNO=1
WHATSAPP_TOKEN=

# Em produção, defina chaves estáveis e secretas (32 bytes em base64 ou qualquer texto longo).
# CPF_CRYPTO_KEY=
# CPF_HMAC_KEY=
# JWT_SECRET=
